{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "arch3",
        "height": 25,
        "width": 30,
        "padding": {
            "top": 3,
            "left": 3
        }
    },
    "display": {
        "separator": ":",
        "key": {
            "width": 17,
            "type": "both-2", // 2 padding between icon and icon name
            "paddingLeft": 2 // padding before icon
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "\u001b[1;32m┌──────────────────────System────────────────────────┐"
        },
        "break",
        {
            "type": "os",
            "key": "OS",
            "keyColor": "green"
        },
        {
            "type": "kernel",
            "key": "Kernel",
            "keyColor": "green"
        },
        {
            "type": "de",
            "key": "DE",
            "keyColor": "green"
        },
        {
            "type": "wm",
            "key": "WM",
            "keyColor": "green"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "keyColor": "green"
        },
        {
            "type": "font",
            "key": "Font",
            "format": "{font1}",
            "keyColor": "green"
        },
        {
            "type": "shell",
            "key": "Shell",
            "keyColor": "green"
        },
        {
            "type": "packages",
            "key": "Packages",
            "keyColor": "green"
        },
        {
            "type": "command",
            "key": "OS Age",
            "keyColor": "green",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "Uptime",
            "keyColor": "green"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[1;32m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[1;33m┌─────────────────────Hardware───────────────────────┐"
        },
        "break",
        {
            "type": "host",
            "key": "Host",
            "keyColor": "yellow"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "format": "{name}",
            "keyColor": "yellow"
        },
        {
            "type": "gpu",
            "key": "GPU",
            "format": "{name}",
            "keyColor": "yellow",
            "hideType": "integrated"
        },
        {
            "type": "memory",
            "key": "RAM",
            "keyColor": "yellow"
        },
        {
            "type": "swap",
            "key": "SWAP",
            "keyColor": "yellow"
        },
        {
            "type": "disk",
            "key": "DISK",
            "keyColor": "yellow"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[1;33m└────────────────────────────────────────────────────┘"
        },
        {
            "type": "custom",
            "format": "                                     \u001b[38;5;3m󰮯 \u001b[38;5;8m󰊠 \u001b[38;5;7m󰊠 \u001b[38;5;6m󰊠 \u001b[38;5;5m󰊠 \u001b[38;5;4m󰊠 \u001b[38;5;2m󰊠 \u001b[38;5;1m󰊠"
        }
    ]
}